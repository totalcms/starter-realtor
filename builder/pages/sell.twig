{#
	Selling, at /sell and /es/sell: how she sells a home in three steps, her
	recent sales, and the "What's my home worth?" form (#valuation, where
	the home page's seller buttons point).
#}
{% extends 'layouts/default.twig' %}

{% block content %}
	{% import 'macros/i18n.twig' as i18n %}
	{% set sales = listings|filter(l => l.mine and l.status == 'sold' and l.soldDate|default('')|date('Y-m-d') >= yearAgo)|sort((a, b) => b.soldDate <=> a.soldDate) %}

	<header class="page-head sheet">
		<p class="eyebrow">{{ info.name }}</p>
		<h1>{{ i18n.t('sellers.title') }}</h1>
		<p>{{ i18n.t('sellers.intro') }}</p>
	</header>

	<section class="sheet">
		<ol class="steps" role="list">
			{% for n in 1..3 %}
				<li>
					<h3>{{ i18n.t('sellers.step' ~ n ~ '_title') }}</h3>
					<p>{{ i18n.t('sellers.step' ~ n ~ '_text') }}</p>
				</li>
			{% endfor %}
		</ol>
	</section>

	{% if sales is not empty %}
		<section class="section sheet" data-rule>
			<div class="stat-row">
				<div class="stat"><strong>{{ sales|length }}</strong><span class="caps">{{ i18n.t('home.sold_stat') }}</span></div>
				{% include 'partials/median-price.twig' with {sales: sales} %}
			</div>
			<div class="listing-grid">{% for l in sales|slice(0, 3) %}{% include 'partials/listing-card.twig' %}{% endfor %}</div>
		</section>
	{% endif %}

	<section class="section" data-blush id="valuation">
		<div class="sheet narrow">
			<div class="section-head">
				<h2>{{ i18n.t('valuation.title') }}</h2>
				<p>{{ i18n.t('valuation.intro') }}</p>
			</div>
			<div class="panel">{% include 'partials/valuation-form.twig' %}</div>
		</div>
	</section>
{% endblock %}
