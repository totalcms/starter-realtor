{#
	The Neighborhoods page, at /neighborhoods and /es/neighborhoods: one card
	per town, in the towns' Sort order. Each card links to the town's page
	(pages/neighborhood.twig). Add a town in the admin and it appears here.
#}
{% extends 'layouts/default.twig' %}

{% block content %}
	{% import 'macros/i18n.twig' as i18n %}
	<header class="page-head sheet">
		<p class="eyebrow">{{ info.name }}</p>
		<h1>{{ i18n.t('towns.title') }}</h1>
		<p>{{ i18n.t('towns.intro') }}</p>
	</header>

	<section class="sheet">
		{% include 'partials/town-grid.twig' %}
	</section>
	<div class="section"></div>
{% endblock %}
