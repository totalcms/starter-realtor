{#
	Options for the new-password form, as JSON. Only for the private list's
	buyers, in the language whitelabel/reset-password-above.twig picked.
#}
{% if collection|default('') == 'buyers' %}
	{% import 'macros/i18n.twig' as i18n %}
	{{ {
		passwordLabel: i18n.t('reset.password') ~ '',
		confirmPasswordLabel: i18n.t('reset.confirm') ~ '',
		submitLabel: i18n.t('reset.submit') ~ ''
	}|json_encode|raw }}
{% endif %}
