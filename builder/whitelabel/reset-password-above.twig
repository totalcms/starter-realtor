{#
	The top of the page a buyer reaches from the reset email, above the
	new-password form. The link in the email carries the redirect from the
	sign-in page, so a buyer who started on an /es page gets this page in
	Spanish. whitelabel/reset-password-options.twig sets the form's labels.
	After saving, Total CMS sends them back to that page (the private list).
#}
{% if collection|default('') == 'buyers' %}
	{% set back = redirect|default('') %}
	{% if back is not iterable and back matches '{^/es(/|\\?|$)}' %}
		{% do cms.locale.set('es') %}
	{% endif %}
	{% import 'macros/i18n.twig' as i18n %}
	<h1>{{ i18n.t('reset.title') }}</h1>
	<p>{{ i18n.t('reset.text') }}</p>
{% else %}
	{{ include('reset-password-above-default.twig') }}
{% endif %}
