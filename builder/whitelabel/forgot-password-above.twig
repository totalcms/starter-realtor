{#
	The top of the forgot-password page, above the form. Like the sign-in page
	(whitelabel/login-above.twig), Total CMS's own page serves both the agent
	and the private list's buyers (/admin/forgot-password/buyers, linked from
	the buyers' sign-in page).

	For buyers it shows the private list's own heading, in the language of the
	page they came from: Total CMS carries the sign-in page's redirect here, and
	a redirect back to an /es address means Spanish. whitelabel/
	forgot-password-options.twig, which runs after this, sets the form's labels.

	After the form is sent, Total CMS shows its own message under the form, in
	English. A Spanish page takes that message and shows its own here instead.
	(Total CMS 3.8 shows its message in the page's language.)

	The reset email itself is Total CMS's own, in English.
#}
{% if collection|default('') == 'buyers' %}
	{% set back = redirect|default('') %}
	{% set spanish = back is not iterable and back matches '{^/es(/|\\?|$)}' %}
	{% if spanish %}
		{% do cms.locale.set('es') %}
	{% endif %}
	{% import 'macros/i18n.twig' as i18n %}
	<h1>{{ i18n.t('forgot.title') }}</h1>
	<p>{{ i18n.t('forgot.text') }}</p>
	{% if spanish %}
		{% if flash.get('error')|length %}
			<p class="cms-twig-error" role="alert">{{ i18n.t('forgot.invalid') }}</p>
		{% endif %}
		{% if flash.get('success')|length %}
			<p class="cms-twig-info" role="alert">{{ i18n.t('forgot.sent') }}</p>
		{% endif %}
	{% endif %}
{% else %}
	{{ include('forgot-password-above-default.twig') }}
{% endif %}
