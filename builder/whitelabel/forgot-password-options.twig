{#
	Options for the forgot-password form, as JSON. Only for the private list's
	buyers: the labels come from builder/strings/ in the language that
	whitelabel/forgot-password-above.twig picked. The agent's page is left as
	it is.
#}
{% if collection|default('') == 'buyers' %}
	{% import 'macros/i18n.twig' as i18n %}
	{{ {
		emailLabel: i18n.t('register.email') ~ '',
		submitLabel: i18n.t('forgot.send') ~ '',
		backToLoginLabel: i18n.t('forgot.back')|e ~ ''
	}|json_encode|raw }}
{% endif %}
