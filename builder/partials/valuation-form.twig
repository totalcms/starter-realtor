{#
	The "What's my home worth?" form, on the Sell page. Each request is saved
	in Valuation Requests (visitors can send one but never read them), then
	the new-valuation email goes to her and the visitor lands on the Thanks
	page.

	The labels and choices come from builder/strings/, so the form follows the
	page's language, and the hidden Language field records which one the
	visitor was reading, so she knows which language to answer in.
#}
{% import 'macros/i18n.twig' as i18n %}
{% set form = cms.form.builder('valuations', {
	addOnly: true,
	botProtection: true,
	fieldIcons: false,
	save: i18n.t('valuation.send') ~ '',
	formgrid: "address address\ntown sqft\nbeds baths\ncondition timeline\nname name\nemail phone\nmessage message",
	newActions: [
		{action: 'mailer', mailerId: 'new-valuation', continue: true},
		{action: 'redirect', link: i18n.url('thanks') ~ '?form=valuation'}
	]
}) %}
{% do form.addField('address', {label: i18n.t('valuation.address'), help: '', settings: {attributes: {autocomplete: 'street-address'}}}) %}
{% do form.addField('town', {field: 'select', label: i18n.t('valuation.town'), help: '', placeholder: i18n.t('valuation.town_pick'),
	options: towns|map(t => {value: t.name, label: t.name})}) %}
{% do form.addField('sqft', {label: i18n.t('valuation.sqft'), help: '', default: ''}) %}
{% do form.addField('beds', {label: i18n.t('valuation.beds'), help: '', default: ''}) %}
{% do form.addField('baths', {label: i18n.t('valuation.baths'), help: '', default: ''}) %}
{% do form.addField('condition', {label: i18n.t('valuation.condition'), help: '',
	options: ['move-in', 'updated', 'project']|map(v => {value: v, label: i18n.t('valuation.condition.' ~ v)})}) %}
{% do form.addField('timeline', {label: i18n.t('valuation.timing'), help: '',
	options: ['curious', '3-6-months', 'ready']|map(v => {value: v, label: i18n.t('valuation.timeline.' ~ v)})}) %}
{% do form.addField('name', {label: i18n.t('valuation.name'), help: '', settings: {attributes: {autocomplete: 'name'}}}) %}
{% do form.addField('email', {label: i18n.t('valuation.email'), help: '', settings: {attributes: {autocomplete: 'email'}}}) %}
{% do form.addField('phone', {label: i18n.t('valuation.phone'), help: '', settings: {attributes: {autocomplete: 'tel'}}}) %}
{% do form.addField('message', {label: i18n.t('valuation.notes'), help: '', settings: {rows: 4}}) %}
{% do form.addField('lang', {field: 'hidden', default: lang}) %}
{{ form.build() }}
