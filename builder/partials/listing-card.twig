{#
	One home as a card: an arched photo with its status, the price, the
	address, then "4 bd · 3 ba · 2,640 sq ft". Her own listings carry a
	rosewood underline and her name on the photo; other agents' homes say
	whose listing it is. A home with no photo shows a quiet blush arch.

	The whole card links to the home. A sold home shows what it sold for.
	Include with {l: the listing}.
#}
{% import 'macros/i18n.twig' as i18n %}
<article class="listing-card"{% if l.mine %} data-mine{% endif %}>
	{% if l.gallery|default([]) is not empty %}
		<figure class="photo">
			{{ cms.render.galleryImage(l, 'first', {w: 760, h: 570, fit: 'crop'}, {collection: 'listings'}) }}
			{% include 'partials/status-label.twig' %}
			{% if l.mine %}<span class="hers caps">{{ i18n.t('listing.hers', {name: info.signature|default(info.name)}) }}</span>{% endif %}
		</figure>
	{% else %}
		<div class="photo" data-empty>
			<svg aria-hidden="true" viewBox="0 0 48 48"><path d="M8 22 24 9l16 13M12 19v20h24V19M20 39V28h8v11" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round"/></svg>
			{% include 'partials/status-label.twig' %}
			{% if l.mine %}<span class="hers caps">{{ i18n.t('listing.hers', {name: info.signature|default(info.name)}) }}</span>{% endif %}
		</div>
	{% endif %}
	<div class="body">
		<p class="price">{{ i18n.price(l.status == 'sold' and l.soldPrice|default(0) ? l.soldPrice : l.price) }}</p>
		<p class="address"><a href="{{ i18n.url('listing', {id: l.id}) }}">{{ l.address }}, {{ townName[l.town]|default(l.town) }}</a></p>
		{% include 'partials/facts.twig' %}
		{% include 'partials/courtesy.twig' %}
	</div>
</article>
