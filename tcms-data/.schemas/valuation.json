{
    "$schema": "https:\/\/json-schema.org\/draft\/2020-12\/schema",
    "$id": "https:\/\/www.totalcms.co\/schemas\/custom\/valuation.json",
    "type": "object",
    "id": "valuation",
    "description": "A seller asking what their home is worth, sent from the Sell page. Visitors can create these but never read them.",
    "properties": {
        "id": {
            "$ref": "https:\/\/www.totalcms.co\/schemas\/properties\/slug.json",
            "label": "ID",
            "help": "Made automatically: the time it was sent plus a random part, so the Thanks page address doesn't carry the visitor's name and can't be guessed.",
            "field": "id",
            "settings": {
                "autogen": "${timestamp}-${uid-10}"
            }
        },
        "address": {
            "type": "string",
            "label": "Home Address",
            "help": "The home they want valued.",
            "field": "text"
        },
        "town": {
            "type": "string",
            "label": "Town",
            "help": "As the visitor typed or picked it.",
            "field": "text"
        },
        "beds": {
            "type": "number",
            "label": "Bedrooms",
            "help": "As the visitor gave it.",
            "field": "number",
            "default": 0
        },
        "baths": {
            "type": "number",
            "label": "Bathrooms",
            "help": "As the visitor gave it.",
            "field": "number",
            "default": 0,
            "settings": {
                "step": 0.5
            }
        },
        "sqft": {
            "type": "number",
            "label": "Square Feet",
            "help": "Approximate, as the visitor gave it.",
            "field": "number",
            "default": 0
        },
        "condition": {
            "type": "string",
            "label": "Condition",
            "help": "The visitor's own view of the home.",
            "field": "select",
            "options": [
                {
                    "value": "move-in",
                    "label": "Move-in ready"
                },
                {
                    "value": "updated",
                    "label": "Some updates needed"
                },
                {
                    "value": "project",
                    "label": "Needs work"
                }
            ],
            "default": "move-in"
        },
        "timeline": {
            "type": "string",
            "label": "Timeline",
            "help": "How soon they might sell. Ready now is the one to call first.",
            "field": "select",
            "options": [
                {
                    "value": "curious",
                    "label": "Just curious"
                },
                {
                    "value": "3-6-months",
                    "label": "In 3 to 6 months"
                },
                {
                    "value": "ready",
                    "label": "Ready now"
                }
            ],
            "default": "curious"
        },
        "name": {
            "type": "string",
            "label": "Name",
            "help": "The visitor's name.",
            "field": "text"
        },
        "email": {
            "$ref": "https:\/\/www.totalcms.co\/schemas\/properties\/email.json",
            "label": "Email",
            "help": "Where to send the valuation.",
            "field": "email"
        },
        "phone": {
            "$ref": "https:\/\/www.totalcms.co\/schemas\/properties\/phone.json",
            "label": "Phone",
            "help": "Optional.",
            "field": "phone"
        },
        "message": {
            "type": "string",
            "label": "Message",
            "help": "Anything else they mentioned.",
            "field": "textarea"
        },
        "lang": {
            "type": "string",
            "label": "Language",
            "help": "The language the visitor was reading when they sent this: reply in it. Set by the form; visitors don't see this field.",
            "field": "select",
            "options": [
                {
                    "value": "en_US",
                    "label": "English"
                },
                {
                    "value": "es",
                    "label": "Spanish"
                }
            ],
            "default": "en_US"
        },
        "status": {
            "type": "string",
            "label": "Status",
            "help": "Where this lead stands. For the agent only: visitors can't set it.",
            "field": "select",
            "options": [
                {
                    "value": "new",
                    "label": "New"
                },
                {
                    "value": "contacted",
                    "label": "Contacted"
                },
                {
                    "value": "closed",
                    "label": "Closed"
                }
            ],
            "protected": true,
            "default": "new"
        },
        "updated": {
            "$ref": "https:\/\/www.totalcms.co\/schemas\/properties\/date.json",
            "label": "Updated",
            "help": "Set automatically when the object is saved.",
            "field": "datetime",
            "settings": {
                "onUpdate": true,
                "readonly": true
            }
        },
        "created": {
            "$ref": "https:\/\/www.totalcms.co\/schemas\/properties\/date.json",
            "label": "Created",
            "help": "Set automatically when the object is created.",
            "field": "datetime",
            "settings": {
                "onCreate": true,
                "readonly": true
            }
        }
    },
    "required": [
        "id",
        "address",
        "name",
        "email"
    ],
    "index": [
        "address",
        "town",
        "timeline",
        "name",
        "email",
        "lang",
        "status",
        "updated",
        "created",
        "id"
    ],
    "formgrid": "id id id id id id\naddress address address town town town\nbeds beds baths baths sqft sqft\ncondition condition condition timeline timeline timeline\nname name email email phone phone\nmessage message message message message message\nlang lang lang status status status\nupdated updated updated created created created",
    "updated": "2026-11-10T17:17:40-08:00",
    "category": "Valeria Montoya"
}